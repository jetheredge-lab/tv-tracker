# Base URL the Expo app calls. EXPO_PUBLIC_* vars are inlined into the JS
# bundle at build time, so never put secrets here.
#
# Cloudflare Tunnel (phone on any network):
EXPO_PUBLIC_API_URL=https://api.meetiqpro.ai
#
# Local backend instead (phone on the same LAN):
# EXPO_PUBLIC_API_URL=http://192.168.50.48:4000
