generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WatchlistStatus {
  WATCHING
  COMPLETED
  /// Movies only: a film is watched or it is not. COMPLETED describes finishing
  /// a run of episodes and reads wrong for a single sitting.
  WATCHED
  PLAN_TO_WATCH
  DROPPED
  ENDED
}

/// Which kind of title a `Show` row holds. The model keeps its name: renaming it
/// to Title would touch ~120 references for no functional gain.
enum MediaType {
  TV
  MOVIE
}

model User {
  id                 String                    @id @default(cuid())
  email              String?                   @unique
  passwordHash       String?
  // Anonymous device identity: the app generates a random secret on first
  // launch and proves it on every sync. Without this a userId alone was a
  // bearer credential - anyone who knew it could read the account.
  deviceSecretHash   String?
  // Opaque token for the .ics subscription URL. Calendar clients cannot
  // send an Authorization header, so the URL itself is the capability -
  // it must therefore NOT contain the userId.
  icsToken           String?                   @unique
  name               String?
  pushToken          String?
  pushAlertsEnabled  Boolean                   @default(true)
  emailAlertsEnabled Boolean                   @default(true)
  preferredRegion    String                    @default("US")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  watchlists         Watchlist[]
  dismissedRecs      DismissedRecommendation[]
  subscriptions      UserSubscription[]

  @@map("users")
}

model Show {
  id                 String                    @id @default(cuid())
  mediaType          MediaType                 @default(TV)
  /// Null for movies - TVmaze indexes television only. Postgres allows many
  /// NULLs in a unique column, so this stays the TV identity key.
  tvmazeId           Int?                      @unique
  /// The movie identity key, and optional enrichment for TV.
  ///
  /// HAZARD: TMDB namespaces movie and TV ids separately, so id 550 is both a
  /// film and a series. A bare unique therefore cannot hold both. It is safe
  /// today only because nothing writes tmdbId for TV rows (verified: 0 rows) -
  /// movies have the column to themselves. The moment TV enrichment starts
  /// populating it, this must become @@unique([mediaType, tmdbId]).
  tmdbId             Int?                      @unique
  title              String
  summary            String?
  posterUrl          String?
  backdropUrl        String?
  /// TV: Running/Ended. Movies: Released/Post Production.
  status             String                    @default("Running")
  /// Canonical vocabulary, normalised at ingest so TV and film taste share one
  /// namespace (see services/genres.ts).
  genres             String[]                  @default([])
  network            String?
  premiered          DateTime?
  /// Movies: theatrical release. TV keeps using `premiered`.
  releaseDate        DateTime?
  /// Movies: feature length. TV runtime is per-episode.
  runtime            Int?
  rating             Float?
  updatedAt          DateTime                  @updatedAt
  episodes           Episode[]
  streamingProviders StreamingProvider[]
  availability       TitleAvailability[]
  watchlists         Watchlist[]
  dismissedRecs      DismissedRecommendation[]

  @@index([title])
  @@index([mediaType])
  @@map("shows")
}

model Watchlist {
  id              String          @id @default(cuid())
  userId          String
  showId          String
  status          WatchlistStatus @default(WATCHING)
  rating          Int? // User rating 1-5 stars
  isFavorite      Boolean         @default(false)
  preferredRegion String          @default("US")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
  @@index([userId])
  @@index([showId])
  @@map("watchlists")
}

model DismissedRecommendation {
  id        String   @id @default(cuid())
  userId    String
  showId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([userId, showId])
  @@index([userId])
  @@index([showId])
  @@map("dismissed_recommendations")
}

model Episode {
  id              String   @id @default(cuid())
  tvmazeEpisodeId Int?     @unique
  showId          String
  season          Int
  number          Int
  title           String
  airdate         String?
  airtime         String?
  summary         String?
  runtime         Int?
  image           String?
  createdAt       DateTime @default(now())

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@index([showId])
  @@index([airdate])
  @@map("episodes")
}

model StreamingProvider {
  id           String   @id @default(cuid())
  showId       String
  providerName String
  logoUrl      String?
  deepLink     String?
  type         String   @default("sub")
  region       String   @default("US")
  createdAt    DateTime @default(now())

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, providerName, region])
  @@index([showId])
  @@map("streaming_providers")
}

/// Local mirror of the full TVmaze show index (~90k rows, refreshed weekly).
/// This is the corpus the recommender scores against - without it the only
/// candidates available were whatever was hardcoded in the service layer.
model CatalogShow {
  tvmazeId    Int       @id
  title       String
  language    String?
  type        String?
  status      String?
  genres      String[]  @default([])
  network     String?
  webChannel  String?
  country     String?
  premiered   DateTime?
  ended       DateTime?
  rating      Float?
  /// TVmaze's own 0-100 popularity score - the keyless "trending" signal.
  weight      Int       @default(0)
  runtime     Int?
  summary     String?
  posterUrl   String?
  backdropUrl String?
  updatedAt   DateTime  @updatedAt

  @@index([weight])
  @@index([rating])
  @@index([premiered])
  @@index([language])
  @@map("catalog_shows")
}

/// Local mirror of TMDB's movie corpus - the film half of the scoring pool.
/// TVmaze has no movies, so unlike catalog_shows this cannot be built without
/// an API key. `popularity` is the movie analogue of TVmaze's `weight`.
model CatalogMovie {
  tmdbId        Int       @id
  title         String
  originalTitle String?
  language      String?
  /// Canonical vocabulary - see services/genres.ts. TMDB says "Science Fiction",
  /// TVmaze says "Science-Fiction"; unnormalised, film and TV taste never meet.
  genres        String[]  @default([])
  releaseDate   DateTime?
  releaseYear   Int?
  rating        Float?
  voteCount     Int       @default(0)
  popularity    Float     @default(0)
  runtime       Int?
  summary       String?
  posterUrl     String?
  backdropUrl   String?
  adult         Boolean   @default(false)
  updatedAt     DateTime  @updatedAt

  @@index([popularity])
  @@index([rating])
  @@index([releaseYear])
  @@index([language])
  @@map("catalog_movies")
}

/// Services the user says they pay for. Deliberately a table and not a column:
/// NO ROWS means "never told us", which must render differently from "subscribes
/// to nothing". Subscriptions bias ranking and badge colour - they never filter.
model UserSubscription {
  id           String   @id @default(cuid())
  userId       String
  /// TMDB (JustWatch) provider id.
  providerId   Int
  providerName String
  region       String   @default("US")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId, region])
  @@index([userId])
  @@map("user_subscriptions")
}

/// Where a title can actually be watched, per region, from TMDB's JustWatch
/// feed. Films move between services constantly, so rows carry `refreshedAt`
/// and are re-pulled far more often than the catalog itself.
/// Attribution to JustWatch is required wherever this is displayed.
model TitleAvailability {
  id           String   @id @default(cuid())
  showId       String
  providerId   Int
  providerName String
  /// flatrate | rent | buy | ads | free
  offerType    String
  region       String   @default("US")
  deepLink     String?
  refreshedAt  DateTime @default(now())

  show Show @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, providerId, offerType, region])
  @@index([showId, region])
  @@map("title_availability")
}
