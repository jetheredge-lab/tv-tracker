# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET="super-secret-tvtracker-jwt-key-change-in-production"
JWT_EXPIRES_IN="30d"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tvtracker?schema=public"

# External API Keys (Optional - Intelligent fallbacks used when omitted)
TMDB_API_KEY=""
WATCHMODE_API_KEY=""

# Email Notifications (Optional - Resend API Key)
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="alerts@tvtracker.app"

# Application / Cloudflare Base URL (for ICS feed deep links)
APP_BASE_URL="http://localhost:4000"

# Cloudflare Tunnel Token (Optional for remote production deployment)
CLOUDFLARE_TUNNEL_TOKEN=""
